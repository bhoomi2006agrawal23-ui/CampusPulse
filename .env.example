# CampusPulse Environment Variables Blueprint
# Copy this file to .env for local configuration

NODE_ENV="development"
PORT="3000"

# Database: MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/campuspulse?retryWrites=true&w=majority"

# Authentication: JWT Secrets & Lifespans
JWT_ACCESS_SECRET="replace_with_a_random_secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="7"

# CORS & Domain Boundaries
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN=""

# Gemini AI API Key
GEMINI_API_KEY=""

# Image Storage Adapter (ImgBB)
IMGBB_API_KEY=""

# Google AI Studio Applet Runtime Defaults
APP_URL="MY_APP_URL"
